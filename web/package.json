{
  "name": "ronditrack-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "generate:api": "openapi-typescript \"${OPENAPI_SCHEMA_URL:-http://localhost:5076/openapi/v1.json}\" -o src/api/schema.d.ts",
    "audit:production": "npm audit --omit=dev",
    "api:types": "openapi-typescript \"${OPENAPI_SCHEMA_URL:-http://localhost:5076/openapi/v1.json}\" -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.90.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "openapi-fetch": "0.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "shadcn": "3.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
