POSTGRES_DB=ronditrack
POSTGRES_USER=ronditrack_app
POSTGRES_PASSWORD=replace_with_a_long_random_password
ConnectionStrings__RondiTrack=Host=db;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
Jwt__SigningKey=replace_with_a_random_secret_at_least_32_bytes
CycleClose__IntervalSeconds=60
Housekeeping__IntervalSeconds=3600
Housekeeping__RefreshTokenRetentionDays=7
Housekeeping__IdempotencyRetentionHours=48
