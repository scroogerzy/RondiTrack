{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.ronditrack.co.za",
    "Audience": "ronditrack-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Contributions": {
      "PermitLimit": 25,
      "WindowSeconds": 60
    },
    "Payouts": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "CycleClose": {
    "IntervalSeconds": 60
  },
  "Housekeeping": {
    "IntervalSeconds": 3600,
    "RefreshTokenRetentionDays": 7,
    "IdempotencyRetentionHours": 48
  }
}
