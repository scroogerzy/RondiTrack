  </ItemGroup>
  <!-- Exclude the nested test project from the production API project. -->
  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="RondiTrack.Tests\**" />
    <EmbeddedResource Remove="RondiTrack.Tests\**" />
    <Content Remove="RondiTrack.Tests\**" />
    <None Remove="RondiTrack.Tests\**" />
  </ItemGroup>
</Project>