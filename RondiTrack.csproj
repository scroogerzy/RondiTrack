<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.6" />
  </ItemGroup>

  <!--
    The test project lives inside the repository, but it must NOT
    be compiled as part of the production API project.
    It is built separately as RondiTrack.Tests.
  -->
  <ItemGroup>
    <Compile Remove="RondiTrack.Tests\**" />
    <EmbeddedResource Remove="RondiTrack.Tests\**" />
    <None Remove="RondiTrack.Tests\**" />
  </ItemGroup>
</Project>
